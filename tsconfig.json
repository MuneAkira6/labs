{
  "compilerOptions": {
    "target": "es2023",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "types": ["node"],
    "skipLibCheck": true
  },
  "include": ["lab-a", "lab-c", "tools", "test", "vitest.config.ts"],
  "exclude": ["**/node_modules", "lab-c/app", "**/results", "lab-a/goldens"]
}
